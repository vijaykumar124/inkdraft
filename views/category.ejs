<!-- ══════════════════════════════════════════════════════
     CATEGORY GALLERY PAGE — NATIONAL PARKS / SWIPEFLOW STYLE
     ══════════════════════════════════════════════════════ -->
<div class="cgal-page">
  <!-- Top Bar Controls -->
  <div class="cgal-top-bar">
    <a href="/#categories" class="cgal-back-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Back to Home
    </a>
    <!-- View Mode Switcher -->
    <div class="cgal-view-toggle">
      <button type="button" class="cgal-toggle-btn active" id="btn-slider-view">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="6" width="20" height="12" rx="2"/><path d="M8 2l-4 4 4 4"/><path d="M16 2l4 4-4 4"/>
        </svg>
        Slider
      </button>
      <button type="button" class="cgal-toggle-btn" id="btn-grid-view">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        Grid
      </button>
    </div>
  </div>

  <!-- Hero Header (National Parks Serif Title) -->
  <div class="cgal-hero-header">
    <h1 class="cgal-title"><%= category.name %></h1>
    <% if (category.description) { %>
      <p class="cgal-desc"><%= category.description %></p>
    <% } %>
    <div class="cgal-meta"><%= images.length %> Artwork<%= images.length !== 1 ? 's' : '' %></div>
  </div>

  <% if (images.length === 0) { %>
    <div class="cgal-empty" style="text-align: center; padding: 80px 20px;">
      <div style="font-size: 3.5rem; margin-bottom: 12px;">🖼️</div>
      <div style="font-size: 1.2rem; font-weight: 600; margin-bottom: 8px;">No gallery images added yet</div>
      <div style="color: var(--text-muted); font-size: 0.9rem;">Upload images in Admin Panel to display them here!</div>
    </div>
  <% } else { %>

    <!-- ── 3D SLIDER VIEW (DEFAULT) ────────────────────────── -->
    <div id="view-slider-container" class="cgal-slider-wrap">
      <div class="cgal-slider-track" id="slider-track">
        <% images.forEach((img, idx) => { %>
          <div class="cgal-slide <%= idx === 0 ? 'active' : '' %>" data-idx="<%= idx %>">
            <img src="<%= img.image %>" alt="<%= img.title || category.name %>" class="cgal-slide-img">
            <div class="cgal-slide-caption-wrap">
              <div class="cgal-slide-tag"><%= category.name %></div>
              <div class="cgal-slide-title"><%= img.title || category.name %></div>
              <div class="cgal-slide-divider"></div>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Circular Orange Arrows -->
      <button type="button" class="cgal-slider-nav cgal-slider-prev" id="slider-prev-btn" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor"/></svg>
      </button>
      <button type="button" class="cgal-slider-nav cgal-slider-next" id="slider-next-btn" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor"/></svg>
      </button>

      <div class="cgal-slider-dots" id="slider-dots">
        <% images.forEach((_, idx) => { %>
          <button type="button" class="cgal-slider-dot <%= idx === 0 ? 'active' : '' %>" data-idx="<%= idx %>"></button>
        <% }); %>
      </div>
    </div>

    <!-- ── GRID VIEW (MASONRY) ─────────────────────────────── -->
    <div id="view-grid-container" class="cgal-masonry" style="display: none;">
      <% images.forEach((img, idx) => { %>
        <div class="cgal-masonry-item" data-idx="<%= idx %>">
          <img src="<%= img.image %>" alt="<%= img.title || category.name %>" class="cgal-masonry-img" loading="lazy">
          <div class="cgal-masonry-overlay">
            <div class="cgal-masonry-icon">⊕</div>
            <% if (img.title) { %>
              <div class="cgal-masonry-caption"><%= img.title %></div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- ── LIGHTBOX MODAL ───────────────────────────────────── -->
    <div class="cgal-lb-backdrop" id="ejs-lightbox" style="display: none;">
      <button type="button" class="cgal-lb-close" id="lb-close-btn">✕</button>
      <button type="button" class="cgal-lb-prev" id="lb-prev-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="cgal-lb-main">
        <img src="" alt="" class="cgal-lb-img" id="lb-main-img">
        <div class="cgal-lb-caption" id="lb-caption"></div>
        <div class="cgal-lb-counter" id="lb-counter"></div>
      </div>

      <button type="button" class="cgal-lb-next" id="lb-next-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <!-- Thumbnail Strip -->
      <div class="cgal-lb-strip" id="lb-strip">
        <% images.forEach((img, idx) => { %>
          <div class="cgal-lb-thumb" data-idx="<%= idx %>">
            <img src="<%= img.image %>" alt="">
          </div>
        <% }); %>
      </div>
    </div>

  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const imagesData = <%- JSON.stringify(images) %>;
  if (!imagesData || imagesData.length === 0) return;

  const btnGrid = document.getElementById('btn-grid-view');
  const btnSlider = document.getElementById('btn-slider-view');
  const gridWrap = document.getElementById('view-grid-container');
  const sliderWrap = document.getElementById('view-slider-container');

  // Toggle View
  btnGrid?.addEventListener('click', () => {
    btnGrid.classList.add('active');
    btnSlider.classList.remove('active');
    gridWrap.style.display = 'block';
    sliderWrap.style.display = 'none';
  });

  btnSlider?.addEventListener('click', () => {
    btnSlider.classList.add('active');
    btnGrid.classList.remove('active');
    gridWrap.style.display = 'none';
    sliderWrap.style.display = 'block';
    updateSlider();
  });

  // 3D Slider logic matching Screenshot 2
  let sliderIdx = 0;
  const slides = document.querySelectorAll('.cgal-slide');
  const dots = document.querySelectorAll('.cgal-slider-dot');

  function updateSlider() {
    const total = slides.length;
    slides.forEach((slide, idx) => {
      let offset = idx - sliderIdx;
      if (offset > total / 2) offset -= total;
      if (offset < -total / 2) offset += total;
      const absOffset = Math.abs(offset);
      const isActive = offset === 0;

      if (absOffset <= 2) {
        slide.style.display = 'block';
        const scale = isActive ? 1.16 : (absOffset === 1 ? 0.78 : 0.58);
        const translateX = offset * 75;
        const opacity = isActive ? 1 : (absOffset === 1 ? 0.65 : 0.35);
        const zIndex = 10 - absOffset;
        const filter = isActive ? 'none' : `grayscale(100%) brightness(0.55)`;

        slide.style.transform = `translateX(${translateX}%) scale(${scale})`;
        slide.style.opacity = opacity;
        slide.style.zIndex = zIndex;
        slide.style.filter = filter;
        if (isActive) slide.classList.add('active');
        else slide.classList.remove('active');
      } else {
        slide.style.display = 'none';
      }
    });

    dots.forEach((dot, idx) => {
      dot.classList.toggle('active', idx === sliderIdx);
    });
  }

  updateSlider();

  document.getElementById('slider-prev-btn')?.addEventListener('click', () => {
    sliderIdx = (sliderIdx - 1 + slides.length) % slides.length;
    updateSlider();
  });
  document.getElementById('slider-next-btn')?.addEventListener('click', () => {
    sliderIdx = (sliderIdx + 1) % slides.length;
    updateSlider();
  });
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      sliderIdx = parseInt(dot.getAttribute('data-idx'));
      updateSlider();
    });
  });

  // Touch Swipe on mobile
  let touchStartX = 0;
  sliderWrap?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  sliderWrap?.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) {
      if (diff > 0) sliderIdx = (sliderIdx + 1) % slides.length;
      else sliderIdx = (sliderIdx - 1 + slides.length) % slides.length;
      updateSlider();
    }
  }, { passive: true });

  // Lightbox Logic
  let lbIdx = null;
  const lbModal = document.getElementById('ejs-lightbox');
  const lbImg = document.getElementById('lb-main-img');
  const lbCap = document.getElementById('lb-caption');
  const lbCount = document.getElementById('lb-counter');
  const thumbs = document.querySelectorAll('.cgal-lb-thumb');

  function openLb(idx) {
    lbIdx = idx;
    lbModal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    renderLb();
  }

  function closeLb() {
    lbIdx = null;
    lbModal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function renderLb() {
    if (lbIdx === null) return;
    const item = imagesData[lbIdx];
    if (!item) return;
    lbImg.src = item.image;
    lbCap.textContent = item.title || '';
    lbCount.textContent = `${lbIdx + 1} / ${imagesData.length}`;
    thumbs.forEach((t, i) => t.classList.toggle('active', i === lbIdx));
    thumbs[lbIdx]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  document.querySelectorAll('.cgal-masonry-item').forEach(item => {
    item.addEventListener('click', () => openLb(parseInt(item.getAttribute('data-idx'))));
  });

  slides.forEach(slide => {
    slide.addEventListener('click', () => {
      const idx = parseInt(slide.getAttribute('data-idx'));
      if (idx === sliderIdx) openLb(idx);
      else {
        sliderIdx = idx;
        updateSlider();
      }
    });
  });

  thumbs.forEach(t => {
    t.addEventListener('click', () => {
      lbIdx = parseInt(t.getAttribute('data-idx'));
      renderLb();
    });
  });

  document.getElementById('lb-close-btn')?.addEventListener('click', closeLb);
  document.getElementById('lb-prev-btn')?.addEventListener('click', () => {
    lbIdx = (lbIdx - 1 + imagesData.length) % imagesData.length;
    renderLb();
  });
  document.getElementById('lb-next-btn')?.addEventListener('click', () => {
    lbIdx = (lbIdx + 1) % imagesData.length;
    renderLb();
  });

  lbModal?.addEventListener('click', (e) => {
    if (e.target === lbModal) closeLb();
  });

  document.addEventListener('keydown', (e) => {
    if (lbIdx !== null) {
      if (e.key === 'ArrowLeft') { lbIdx = (lbIdx - 1 + imagesData.length) % imagesData.length; renderLb(); }
      if (e.key === 'ArrowRight') { lbIdx = (lbIdx + 1) % imagesData.length; renderLb(); }
      if (e.key === 'Escape') closeLb();
    } else if (sliderWrap.style.display !== 'none') {
      if (e.key === 'ArrowLeft') { sliderIdx = (sliderIdx - 1 + slides.length) % slides.length; updateSlider(); }
      if (e.key === 'ArrowRight') { sliderIdx = (sliderIdx + 1) % slides.length; updateSlider(); }
    }
  });
});
</script>
