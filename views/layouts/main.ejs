<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'InkDraft - Premium Tattoo Studio with world-class artists' %>">
  <title><%= typeof title !== 'undefined' ? title : 'InkDraft' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖋</text></svg>">

  <!-- Apply saved theme BEFORE paint to avoid flash -->
  <script>
    (function() {
      try {
        if (localStorage.getItem('inkdraft-theme') === 'day') {
          document.documentElement.style.setProperty('--flash', '1');
          document.addEventListener('DOMContentLoaded', function() {
            document.body.classList.add('day-mode');
          });
        }
      } catch(e) {}
    })();
  </script>
</head>
<body>

<%- body %>

<script src="/js/main.js"></script>
</body>
</html>
