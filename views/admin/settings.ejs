<!-- Settings Page -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">

  <!-- General Settings -->
  <div class="card" style="grid-column:1/-1">
    <div class="card-header">
      <div class="card-title">⚙️ Site Settings</div>
      <span class="badge badge-gold">All changes save immediately</span>
    </div>
    <div class="card-body">
      <form id="settings-form">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px">

          <!-- SEO & Branding -->
          <div>
            <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)">
              SEO & Branding
            </div>
            <div class="form-group">
              <label class="form-label">Site Title</label>
              <input type="text" name="siteTitle" class="form-control" value="<%= settings.siteTitle || 'InkDraft - Design Your Next Tattoo' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Meta Description</label>
              <textarea name="metaDescription" class="form-control" style="min-height:80px"><%= settings.metaDescription || '' %></textarea>
            </div>
          </div>

          <!-- Hero Section -->
          <div>
            <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)">
              Hero Section
            </div>
            <div class="form-group">
              <label class="form-label">Hero Description</label>
              <textarea name="heroDescription" class="form-control" style="min-height:80px"><%= settings.heroDescription || '' %></textarea>
            </div>
          </div>

          <!-- Stats -->
          <div>
            <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)">
              Homepage Stats
            </div>
            <div class="form-grid cols-3">
              <div class="form-group">
                <label class="form-label">Designs Count</label>
                <input type="number" name="statDesigns" class="form-control" value="<%= settings.statDesigns || 3000 %>">
              </div>
              <div class="form-group">
                <label class="form-label">Artists Count</label>
                <input type="number" name="statArtists" class="form-control" value="<%= settings.statArtists || 50 %>">
              </div>
              <div class="form-group">
                <label class="form-label">Clients Count</label>
                <input type="number" name="statClients" class="form-control" value="<%= settings.statClients || 8500 %>">
              </div>
              <div class="form-group">
                <label class="form-label">Years Exp.</label>
                <input type="number" name="statYears" class="form-control" value="<%= settings.statYears || 12 %>">
              </div>
            </div>
          </div>

          <!-- Contact Info -->
          <div>
            <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)">
              Contact Information
            </div>
            <div class="form-group">
              <label class="form-label">Contact Email</label>
              <input type="email" name="contactEmail" class="form-control" value="<%= settings.contactEmail || 'hello@inkdraft.com' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Phone Number</label>
              <input type="text" name="contactPhone" class="form-control" value="<%= settings.contactPhone || '+1 555 000 0000' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Studio Address</label>
              <input type="text" name="address" class="form-control" value="<%= settings.address || '123 Art District, NYC' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Business Hours</label>
              <input type="text" name="hours" class="form-control" value="<%= settings.hours || 'Mon–Sat: 10am – 8pm' %>">
            </div>
          </div>

          <!-- Social Media -->
          <div>
            <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)">
              Social Media Links
            </div>
            <div class="form-group">
              <label class="form-label">Instagram URL</label>
              <input type="url" name="socialInstagram" class="form-control" value="<%= settings.socialInstagram || '' %>" placeholder="https://instagram.com/...">
            </div>
            <div class="form-group">
              <label class="form-label">Facebook URL</label>
              <input type="url" name="socialFacebook" class="form-control" value="<%= settings.socialFacebook || '' %>" placeholder="https://facebook.com/...">
            </div>
            <div class="form-group">
              <label class="form-label">TikTok URL</label>
              <input type="url" name="socialTiktok" class="form-control" value="<%= settings.socialTiktok || '' %>" placeholder="https://tiktok.com/@...">
            </div>
          </div>

          <!-- Features -->
          <div>
            <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)">
              Feature Toggles
            </div>
            <div style="display:flex;flex-direction:column;gap:14px">
              <div class="toggle-wrap">
                <label class="toggle">
                  <input type="checkbox" name="showOrders" <%= settings.showOrders !== 'false' ? 'checked' : '' %> onchange="this.form.elements['showOrders'].value = this.checked">
                  <span class="toggle-slider"></span>
                </label>
                <span class="toggle-label">Show Order Form on homepage</span>
              </div>
              <div class="toggle-wrap">
                <label class="toggle">
                  <input type="checkbox" name="showPricing" <%= settings.showPricing !== 'false' ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <span class="toggle-label">Show Pricing Section</span>
              </div>
              <div class="toggle-wrap">
                <label class="toggle">
                  <input type="checkbox" name="maintenanceMode" <%= settings.maintenanceMode === 'true' ? 'checked' : '' %>>
                  <span class="toggle-slider"></span>
                </label>
                <span class="toggle-label" style="color:var(--danger)">⚠ Maintenance Mode</span>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--border-subtle);display:flex;justify-content:flex-end;gap:12px">
          <button type="reset" class="btn btn-secondary">Reset Changes</button>
          <button type="submit" class="btn btn-primary">💾 Save All Settings</button>
        </div>
      </form>
    </div>
  </div>
</div>
