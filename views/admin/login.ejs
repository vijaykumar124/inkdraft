<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — InkDraft</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .login-page {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: var(--bg-base);
    }
    .login-left {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 60px;
    }
    .login-right {
      background: linear-gradient(160deg, #0d0d00, #080808);
      border-left: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .login-right::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(201,168,76,0.08) 0%, transparent 70%);
    }
    .login-brand { text-align: center; margin-bottom: 48px; }
    .login-brand-logo {
      width: 56px; height: 56px;
      background: linear-gradient(135deg, var(--gold), var(--gold-dark));
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem; font-weight: 900; color: #0a0a0a;
      margin: 0 auto 16px;
    }
    .login-brand-name { font-size: 1.5rem; font-weight: 900; letter-spacing: -0.03em; }
    .login-brand-name span { color: var(--gold); }
    .login-brand-sub { font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 4px; }
    .login-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 40px;
      width: 100%;
      max-width: 400px;
    }
    .login-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 6px; }
    .login-subtitle { font-size: 0.83rem; color: var(--text-secondary); margin-bottom: 32px; }
    .login-error {
      background: rgba(224,92,92,0.1);
      border: 1px solid rgba(224,92,92,0.2);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      font-size: 0.83rem;
      color: var(--danger);
      margin-bottom: 20px;
    }
    .login-submit {
      width: 100%;
      justify-content: center;
      margin-top: 8px;
      padding: 13px;
      font-size: 0.88rem;
    }
    .login-visual-text {
      text-align: center;
      position: relative;
      z-index: 1;
      padding: 40px;
    }
    .login-visual-text h2 {
      font-size: 2.5rem; font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.1;
      margin-bottom: 16px;
    }
    .login-visual-text p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; }
    .login-visual-stats {
      display: flex; gap: 40px; justify-content: center;
      margin-top: 40px;
    }
    .lv-stat-num { font-size: 2rem; font-weight: 800; color: var(--gold); display: block; }
    .lv-stat-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); }
    @media (max-width: 768px) {
      .login-page { grid-template-columns: 1fr; }
      .login-right { display: none; }
      .login-left { padding: 32px 24px; }
    }
  </style>
</head>
<body class="admin-body" style="display:block">

<div class="login-page">
  <div class="login-left">
    <div class="login-brand">
      <div class="login-brand-logo">I</div>
      <div class="login-brand-name">Ink<span>Draft</span></div>
      <div class="login-brand-sub">Admin Panel</div>
    </div>

    <div class="login-card">
      <h1 class="login-title">Welcome back</h1>
      <p class="login-subtitle">Sign in to manage your tattoo studio</p>

      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="login-error">⚠ <%= error[0] %></div>
      <% } %>

      <form action="/admin/login" method="POST" autocomplete="off">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="admin@inkdraft.com" required autofocus>
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary login-submit">Sign In →</button>
      </form>
    </div>
  </div>

  <div class="login-right">
    <div class="login-visual-text">
      <h2>Manage Your<br><span style="color:var(--gold)">Premium Studio</span></h2>
      <p>Complete control over your tattoo studio — artists, designs, orders, and all site settings.</p>
      <div class="login-visual-stats">
        <div><span class="lv-stat-num">3K+</span><div class="lv-stat-label">Designs</div></div>
        <div><span class="lv-stat-num">50+</span><div class="lv-stat-label">Artists</div></div>
        <div><span class="lv-stat-num">8K+</span><div class="lv-stat-label">Clients</div></div>
      </div>
    </div>
  </div>
</div>

</body>
</html>
