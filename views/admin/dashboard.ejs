<!-- Dashboard -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-value"><%= totalOrders || 0 %></div>
      <div class="stat-label">Total Orders</div>
      <div class="stat-change up">↑ All time</div>
    </div>
    <div class="stat-icon-wrap">📋</div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-value" style="color:var(--warning)"><%= pendingOrders || 0 %></div>
      <div class="stat-label">Pending Orders</div>
      <div class="stat-change" style="color:var(--warning)">⏳ Needs attention</div>
    </div>
    <div class="stat-icon-wrap">⏳</div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-value"><%= totalArtists || 0 %></div>
      <div class="stat-label">Active Artists</div>
      <div class="stat-change up">↑ Active</div>
    </div>
    <div class="stat-icon-wrap">👤</div>
  </div>
  <div class="stat-card">
    <div class="stat-info">
      <div class="stat-value"><%= totalDesigns || 0 %></div>
      <div class="stat-label">Total Designs</div>
      <div class="stat-change up">↑ In gallery</div>
    </div>
    <div class="stat-icon-wrap">🎨</div>
  </div>
</div>

<!-- Order Status Overview + Recent Orders -->
<div style="display:grid;grid-template-columns:1fr 2fr;gap:24px;margin-bottom:28px">

  <!-- Status Breakdown -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Order Status</div>
    </div>
    <div class="card-body">
      <% const statusColors = { pending: '#e8a53c', reviewing: '#4c8ecf', quoted: '#c9a84c', confirmed: '#4caf6e', 'in-progress': '#4c8ecf', completed: '#4caf6e', cancelled: '#e05c5c' }; %>
      <% if (ordersByStatus && ordersByStatus.length > 0) { %>
        <% ordersByStatus.forEach(s => { %>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border-subtle)">
            <div style="display:flex;align-items:center;gap:8px;font-size:0.83rem;text-transform:capitalize;color:var(--text-secondary)">
              <span style="width:8px;height:8px;border-radius:50%;background:<%= statusColors[s._id] || '#888' %>;flex-shrink:0"></span>
              <%= s._id %>
            </div>
            <span style="font-weight:700;font-size:0.9rem"><%= s.count %></span>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state" style="padding:32px 0">
          <div class="empty-icon">📋</div>
          <div class="empty-title">No orders yet</div>
        </div>
      <% } %>

      <div style="margin-top:20px">
        <a href="/admin/orders" class="btn btn-primary btn-sm" style="width:100%;justify-content:center">View All Orders →</a>
      </div>
    </div>
  </div>

  <!-- Recent Orders Table -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Recent Orders</div>
      <a href="/admin/orders" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Order #</th>
            <th>Client</th>
            <th>Style</th>
            <th>Status</th>
            <th>Date</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentOrders && recentOrders.length > 0) { %>
            <% recentOrders.forEach(order => { %>
              <tr>
                <td><span style="color:var(--gold);font-weight:600"><%= order.orderNumber %></span></td>
                <td>
                  <div style="font-weight:600;color:var(--text-primary);font-size:0.85rem"><%= order.clientName %></div>
                  <div style="font-size:0.72rem;color:var(--text-muted)"><%= order.clientEmail %></div>
                </td>
                <td><%= order.tattooStyle %></td>
                <td>
                  <% const badgeClass = { pending: 'badge-warning', reviewing: 'badge-blue', quoted: 'badge-gold', confirmed: 'badge-green', completed: 'badge-green', cancelled: 'badge-red' }; %>
                  <span class="badge <%= badgeClass[order.status] || 'badge-gray' %>"><%= order.status %></span>
                </td>
                <td style="color:var(--text-muted);font-size:0.78rem"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                <td>
                  <a href="/admin/orders?id=<%= order._id %>" class="btn btn-secondary btn-sm btn-icon" title="View Order">👁</a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6"><div class="empty-state"><div class="empty-icon">📋</div><div class="empty-title">No orders yet</div></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="card">
  <div class="card-header">
    <div class="card-title">Quick Actions</div>
  </div>
  <div class="card-body">
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a href="/admin/artists" class="btn btn-secondary">👤 Manage Artists</a>
      <a href="/admin/designs" class="btn btn-secondary">🎨 Add Design</a>
      <a href="/admin/categories" class="btn btn-secondary">📁 Categories</a>
      <a href="/admin/testimonials" class="btn btn-secondary">⭐ Testimonials</a>
      <a href="/admin/pricing" class="btn btn-secondary">💳 Edit Pricing</a>
      <a href="/admin/settings" class="btn btn-primary">⚙️ Site Settings</a>
      <a href="/" target="_blank" class="btn btn-secondary">🌐 View Live Site</a>
    </div>
  </div>
</div>
