<!-- ══════════════════════════════════════════════════════
     NAVBAR — Matches screenshot: Logo | Links | 🌙 Login | Get Started
     ══════════════════════════════════════════════════════ -->
<nav id="navbar">
  <div class="container">
    <div class="nav-inner">

      <!-- Logo -->
      <a href="/" class="nav-logo">
        <div class="nav-logo-icon">𝔻</div>
        InkDraft
      </a>

      <!-- Center Links -->
      <ul class="nav-links">
        <li><a href="#categories">Styles</a></li>
        <li><a href="#journey">How it works</a></li>
        <li><a href="#featured">Gallery</a></li>
        <li><a href="#artists">Artists</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="#testimonials">Reviews</a></li>
      </ul>

      <!-- Right: theme toggle + login + CTA -->
      <div class="nav-cta">
        <!-- Day/Night Toggle Button -->
        <button class="theme-toggle" id="theme-toggle" title="Toggle day/night mode" aria-label="Toggle theme">
          <!-- Moon icon (shown in dark/night mode) -->
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <!-- Sun icon (shown in light/day mode) -->
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>

        <% if (typeof user !== 'undefined' && user) { %>
          <div class="user-profile-menu">
            <button class="user-profile-btn" id="user-menu-toggle" type="button">
              <span class="user-avatar-small"><%= user.name.charAt(0).toUpperCase() %></span>
              <span class="user-name-small"><%= user.name.split(' ')[0] %></span>
              <span style="font-size:0.7rem;opacity:0.7">▾</span>
            </button>
            <div class="user-dropdown-content" id="user-dropdown">
              <div class="user-dropdown-header">
                <div style="font-weight: 700; color: var(--text-primary);"><%= user.name %></div>
                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= user.email %></div>
              </div>
              <a href="/api/user/logout" class="user-dropdown-item logout-item">🚪 Logout</a>
            </div>
          </div>
        <% } else { %>
          <button type="button" class="nav-login" id="open-auth-modal">Login / Register</button>
        <% } %>

        <a href="#order-form" class="nav-get-started">Get Started</a>
      </div>

      <!-- Mobile hamburger -->
      <button class="nav-hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Nav -->
<nav class="nav-mobile" id="nav-mobile">
