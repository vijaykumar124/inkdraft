      alt="Premium Japanese sleeve tattoo"
      class="hero-image-main"
      fetchpriority="high">
    <div class="hero-badge">
      <div class="hero-badge-icon">🏆</div>
      <div class="hero-badge-text">
        <strong>Award Winning Studio</strong>
        <span>Best Tattoo Studio 2024</span>
      </div>
