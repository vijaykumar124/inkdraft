    <div class="hero-stats" data-reveal style="transition-delay:0.42s">
      <div>
        <span class="hero-stat-number" data-counter="<%= settings.statDesigns || 3000 %>">0</span>
        <div class="hero-stat-label">Designs Created</div>
      </div>
      <div>
        <span class="hero-stat-number" data-counter="<%= settings.statArtists || 50 %>">0</span>
        <div class="hero-stat-label">Expert Artists</div>
      </div>
      <div>
        <span class="hero-stat-number" data-counter="<%= settings.statClients || 8500 %>">0</span>
        <div class="hero-stat-label">Happy Clients</div>
      </div>
      <div>
        <span class="hero-stat-number" data-counter="<%= settings.statYears || 12 %>">0</span>
