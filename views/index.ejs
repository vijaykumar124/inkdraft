<section id="pricing" class="section" style="background:var(--bg-secondary)">
  <div class="container">
    <div class="text-center" style="margin-bottom:56px">
      <span class="eyebrow">Investment</span>
      <h2 class="heading-lg" data-reveal>Choose Your <span class="text-gold">Perfect Plan</span></h2>
      <p class="body-md" style="margin-top:14px" data-reveal>All plans include free consultation, revisions, and aftercare guide.</p>
    </div>
    <div class="pricing-grid">
      <%
        const defaultPlans = [
          { name:'Starter',  price:29,  desc:'Perfect for small, simple designs',            popular:false, features:['1 design concept','Up to 2 revisions','Standard placement','Digital file','Aftercare guide']                           },
          { name:'Premium',  price:89,  desc:'Our most popular package for custom work',      popular:true,  features:['3 design concepts','Unlimited revisions','Artist consultation','Priority booking','Full aftercare kit','Touch-up session'] },
          { name:'Elite',    price:249, desc:'Full sleeve & complex full-body artwork',       popular:false, features:['Custom concept art','Dedicated senior artist','Full sleeve planning','Multiple sessions','VIP access','1 year touch-ups','Photo session'] }
        ];
        const showPlans = (pricingPlans && pricingPlans.length > 0) ? pricingPlans : defaultPlans;
      %>
      <% showPlans.forEach((plan, i) => { %>
        <div class="pricing-card <%= plan.isPopular || plan.popular ? 'popular' : '' %>" data-reveal style="transition-delay:<%= i*0.1 %>s">
          <% if(plan.isPopular || plan.popular) { %><span class="popular-badge">Most Popular</span><% } %>
          <div class="pricing-name"><%= plan.name %></div>
          <div class="pricing-price">
            <span class="pricing-currency">$</span>
            <span class="pricing-amount"><%= plan.price %></span>
            <span class="pricing-period">/<%= plan.period || 'session' %></span>
          </div>
          <p class="pricing-desc"><%= plan.description || plan.desc %></p>
          <ul class="pricing-features">
            <% (plan.features || []).forEach(f => { %>
              <li class="pricing-feature"><span class="feature-check">✓</span> <%= f %></li>
            <% }); %>
          </ul>
          <a href="#order-form" class="btn <%= plan.isPopular || plan.popular ? 'btn-gold' : 'btn-outline' %>" style="width:100%;justify-content:center;margin-top:auto">
            <%= plan.ctaText || 'Book Now' %> →
          </a>
        </div>
      <% }); %>
    </div>
  </div>
</section>

