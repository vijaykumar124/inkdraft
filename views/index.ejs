<!-- ══════════════════════════════════════════════════════
     ARTISTS
     ══════════════════════════════════════════════════════ -->
<section id="artists" class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">The Team</span>
        <h2 class="heading-lg" data-reveal>Meet Our <span class="text-gold">Artists</span></h2>
      </div>
    </div>
    <div class="artists-grid">
      <%
        const demoArtists = [
          { name:'Alex Rivera',   specialty:'Japanese',  img:'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80&fit=crop&crop=face', rating:'5.0', reviewCount:247,  instagram:'alex_inkcraft'   },
          { name:'Maya Chen',     specialty:'Fine Line', img:'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&q=80&fit=crop&crop=face', rating:'4.9', reviewCount:198,  instagram:'maya_fineline'   },
          { name:'Jordan Blake',  specialty:'Geometric', img:'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80&fit=crop&crop=face', rating:'4.8', reviewCount:156,  instagram:'jordan_geo'      },
          { name:'Sam Torres',    specialty:'Realism',   img:'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&q=80&fit=crop&crop=face', rating:'5.0', reviewCount:312,  instagram:'sam_realism'     },
          { name:'Kai Nakamura',  specialty:'Blackwork', img:'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&q=80&fit=crop&crop=face', rating:'4.9', reviewCount:203,  instagram:'kai_blackwork'   }
        ];
        const showArtists = (artists && artists.length > 0) ? artists : demoArtists;
      %>
      <% showArtists.slice(0,5).forEach((a, i) => { %>
        <div class="artist-card" data-reveal style="transition-delay:<%= i*0.08 %>s">
          <div class="artist-photo">
            <img src="<%= a.image || a.img %>" alt="<%= a.name %>" loading="lazy">
            <div class="artist-photo-overlay">
              <span class="artist-instagram">📸 @<%= a.instagram || 'inkdraft' %></span>
            </div>
          </div>
          <div class="artist-name"><%= a.name %></div>
          <div class="artist-specialty"><%= a.specialty %></div>
          <div class="artist-rating">
            <span class="star">★</span> <%= a.rating || '5.0' %>
            <span style="color:var(--text-muted)">(<%= a.reviewCount || 0 %> reviews)</span>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     TESTIMONIALS
     ══════════════════════════════════════════════════════ -->
<section id="testimonials" class="section" style="background:var(--bg-secondary)">
  <div class="container">
    <div class="text-center" style="margin-bottom:52px">
      <span class="eyebrow">Client Stories</span>
      <h2 class="heading-lg" data-reveal>Trusted by <span class="text-gold">Thousands</span></h2>
    </div>
    <div class="testimonials-track">
      <%
        const demoReviews = [
          { name:'Sarah M.',  location:'New York, NY',    rating:5, review:'Absolutely blown away by my sleeve. The artist understood exactly what I wanted and brought it to life in the most incredible way. 10/10 would recommend InkDraft to anyone.' },
          { name:'James K.',  location:'Los Angeles, CA', rating:5, review:'From the initial consultation to the final session, the entire experience was world-class. My geometric back piece is exactly what I envisioned. Pure artistry.' },
          { name:'Priya S.',  location:'Chicago, IL',     rating:5, review:'I was nervous about my first tattoo, but the team made me feel so comfortable. The fine line botanical piece on my forearm is delicate and perfect. Couldn\'t be happier!' }
        ];
        const showReviews = (testimonials && testimonials.length > 0) ? testimonials : demoReviews;
      %>
      <% showReviews.forEach((t, i) => { %>
        <div class="testimonial-card" data-reveal style="transition-delay:<%= i*0.1 %>s">
          <div class="testimonial-stars">
            <% for(let s=0;s<(t.rating||5);s++) { %><span class="star">★</span><% } %>
          </div>
          <p class="testimonial-text">"<%= t.review %>"</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style="background:var(--gold-glow);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--gold);font-size:0.85rem">
              <%= t.name.charAt(0) %>
            </div>
            <div>
              <div class="testimonial-name"><%= t.name %></div>
              <div class="testimonial-location"><%= t.location || t.tattooStyle || '' %></div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

