    </div>

    <div class="categories-grid">
      <%
        const defaultCats = [
          { name: 'Traditional',  img: 'https://images.unsplash.com/photo-1612459284453-a2b74c3f57c3?w=200&q=70&fit=crop&crop=center' },
          { name: 'Minimalist',   img: 'https://images.unsplash.com/photo-1567527827878-a5d3aba7eec5?w=200&q=70&fit=crop&crop=center' },
          { name: 'Geometric',    img: 'https://images.unsplash.com/photo-1543489822-c49534f3271f?w=200&q=70&fit=crop&crop=center' },
          { name: 'Blackwork',    img: 'https://images.unsplash.com/photo-1597075380606-cf8e1e8a6f8b?w=200&q=70&fit=crop&crop=center' },
          { name: 'Watercolor',   img: 'https://images.unsplash.com/photo-1561883088-039e53143d73?w=200&q=70&fit=crop&crop=center' },
          { name: 'Realism',      img: 'https://images.unsplash.com/photo-1554188248-986adbb73be4?w=200&q=70&fit=crop&crop=center' },
          { name: 'Japanese',     img: 'https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?w=200&q=70&fit=crop&crop=center' },
          { name: 'Fine Line',    img: 'https://images.unsplash.com/photo-1590246813516-a8b8d47c74c5?w=200&q=70&fit=crop&crop=center' }
        ];
        const displayCats = (categories && categories.length > 0) ? categories : defaultCats;
      %>
      <% displayCats.forEach((cat, i) => { %>
        <div class="category-card" data-reveal style="transition-delay: <%= i * 0.07 %>s">
          <div class="category-circle">
            <img src="<%= cat.image || cat.img %>" alt="<%= cat.name %>" loading="lazy">
          </div>
          <span class="category-name"><%= cat.name %></span>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     HOW IT WORKS
     ══════════════════════════════════════════════════════ -->
<section id="journey" class="section" style="background:var(--bg-secondary)">
  <div class="container">
    <div class="text-center" style="margin-bottom:0">
      <span class="eyebrow">How It Works</span>
      <h2 class="heading-lg" data-reveal>Your Tattoo <span class="text-gold">Journey</span></h2>
    </div>
    <div class="journey-grid">
      <% [
        { num:'01', title:'Share Your Vision',      desc:'Tell us your idea, style preference, placement, and size. Upload any reference images for inspiration.' },
        { num:'02', title:'Artist Matching',        desc:'We match you with the perfect artist based on your style and their expertise. Get personalized quotes.' },
        { num:'03', title:'Design Consultation',    desc:'Collaborate directly with your artist to refine the design until it\'s exactly what you imagined.' },
        { num:'04', title:'Get Inked',              desc:'Visit our studio or book a session. Walk out with art that lasts a lifetime, with complete aftercare support.' }
      ].forEach((step, i) => { %>
        <div class="journey-step" data-reveal style="transition-delay: <%= i * 0.1 %>s">
          <div class="journey-number"><%= step.num %></div>
          <h3><%= step.title %></h3>
          <p><%= step.desc %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     ORDER FORM
     ══════════════════════════════════════════════════════ -->
<section id="order-form" class="section">
  <div class="container">
    <div class="text-center" style="margin-bottom:52px">
      <span class="eyebrow">Custom Design</span>
      <h2 class="heading-lg" data-reveal>Order Your Custom<br><span class="text-gold">Tattoo Design</span></h2>
      <p class="body-md" style="margin-top:14px" data-reveal>Fill in the details and we'll connect you with the perfect artist within 24 hours.</p>
    </div>
    <div class="form-card" data-reveal="scale">
      <form id="tattoo-order-form" autocomplete="off">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Your Name *</label>
            <input type="text" name="clientName" class="form-control" placeholder="John Doe" required>
          </div>
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input type="email" name="clientEmail" class="form-control" placeholder="john@example.com" required>
          </div>
          <div class="form-group">
            <label class="form-label">Phone Number</label>
            <input type="tel" name="clientPhone" class="form-control" placeholder="+1 (555) 000-0000">
          </div>
          <div class="form-group">
            <label class="form-label">Tattoo Style *</label>
            <select name="tattooStyle" class="form-control" required>
              <option value="" disabled selected>Select a style</option>
              <option>Traditional</option><option>Neo-Traditional</option><option>Minimalist</option>
              <option>Geometric</option><option>Watercolor</option><option>Blackwork</option>
              <option>Realism</option><option>Japanese</option><option>Tribal</option>
              <option>Fine Line</option><option>Dotwork</option><option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Placement *</label>
            <select name="placement" class="form-control" required>
              <option value="" disabled selected>Body placement</option>
              <option>Arm (Upper)</option><option>Arm (Lower / Forearm)</option><option>Full Sleeve</option>
              <option>Chest</option><option>Back (Upper)</option><option>Back (Full)</option>
              <option>Rib</option><option>Leg (Thigh)</option><option>Leg (Calf)</option>
              <option>Ankle / Foot</option><option>Neck</option><option>Hand / Fingers</option><option>Other</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Approximate Size *</label>
            <select name="size" class="form-control" required>
              <option value="" disabled selected>Size of tattoo</option>
              <option>Tiny (under 2")</option><option>Small (2-4")</option><option>Medium (4-6")</option>
              <option>Large (6-10")</option><option>Extra Large (10"+)</option>
              <option>Half Sleeve</option><option>Full Sleeve</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Budget Range</label>
            <select name="budget" class="form-control">
              <option value="" disabled selected>Select budget</option>
              <option>Under $100</option><option>$100 – $250</option><option>$250 – $500</option>
              <option>$500 – $1,000</option><option>$1,000 – $2,500</option><option>$2,500+</option>
            </select>
          </div>
          <% if(artists && artists.length > 0) { %>
          <div class="form-group">
            <label class="form-label">Preferred Artist</label>
            <select name="preferredArtist" class="form-control">
              <option value="">No preference</option>
              <% artists.forEach(a => { %>
                <option value="<%= a._id %>"><%= a.name %> — <%= a.specialty %></option>
              <% }); %>
            </select>
          </div>
          <% } %>
          <div class="form-group full">
            <label class="form-label">Describe Your Vision *</label>
            <textarea name="description" class="form-control" required placeholder="Tell us about your tattoo idea — the design, meaning, imagery, colors, or any specific elements you want included..."></textarea>
          </div>
        </div>
        <div class="form-submit">
          <button type="submit" class="btn btn-gold btn-lg">Submit My Design Request →</button>
          <p class="form-note">🔒 We'll never share your info. Response within 24 hours.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     FEATURED DESIGNS
     ══════════════════════════════════════════════════════ -->
<section id="featured" class="section" style="background:var(--bg-secondary)">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="eyebrow">Our Portfolio</span>
        <h2 class="heading-lg" data-reveal>Featured <span class="text-gold">Designs</span></h2>
      </div>
      <a href="#order-form" class="btn btn-outline">Get Similar Design →</a>
    </div>
    <div class="designs-grid">
      <%
        const demoDesigns = [
          { img:'https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?w=800&q=80&fit=crop', title:'Dragon Sleeve',     cat:'Japanese'    },
          { img:'https://images.unsplash.com/photo-1543489822-c49534f3271f?w=800&q=80&fit=crop', title:'Geometric Wolf',    cat:'Geometric'   },
          { img:'https://images.unsplash.com/photo-1597075380606-cf8e1e8a6f8b?w=800&q=80&fit=crop', title:'Rose Blackwork',   cat:'Blackwork'   },
          { img:'https://images.unsplash.com/photo-1590246813516-a8b8d47c74c5?w=800&q=80&fit=crop', title:'Fine Line Portrait',cat:'Fine Line'   },
          { img:'https://images.unsplash.com/photo-1612459284453-a2b74c3f57c3?w=800&q=80&fit=crop', title:'Traditional Eagle', cat:'Traditional' },
          { img:'https://images.unsplash.com/photo-1561883088-039e53143d73?w=800&q=80&fit=crop', title:'Watercolor Galaxy', cat:'Watercolor'  }
        ];
        const showDesigns = (featuredDesigns && featuredDesigns.length > 0) ? featuredDesigns : demoDesigns;
      %>
      <% showDesigns.slice(0,6).forEach((d, i) => { %>
