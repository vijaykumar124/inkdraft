<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'Error' %> — InkDraft</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #080808;
      color: #f0ebe0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .error-box {
      text-align: center;
      max-width: 520px;
    }
    .error-code {
      font-size: 7rem;
      font-weight: 800;
      background: linear-gradient(135deg, #c9a84c, #a6852f);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      margin-bottom: 16px;
    }
    .error-title { font-size: 1.6rem; font-weight: 700; margin-bottom: 12px; }
    .error-msg { color: #8a7a68; font-size: 1rem; line-height: 1.6; margin-bottom: 32px; }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: linear-gradient(135deg, #c9a84c, #a6852f);
      color: #000;
      font-weight: 700;
      font-size: 0.95rem;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.2s;
      margin: 0 6px;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(201,168,76,0.3); }
    .btn-outline {
      background: transparent;
      color: #c9a84c;
      border: 1px solid rgba(201,168,76,0.3);
    }
    .btn-outline:hover { background: rgba(201,168,76,0.08); box-shadow: none; }
  </style>
</head>
<body>
  <div class="error-box">
    <div class="error-code"><%= typeof title !== 'undefined' && title === '404' ? '404' : '⚠' %></div>
    <div class="error-title"><%= typeof title !== 'undefined' && title === '404' ? 'Page Not Found' : 'Something Went Wrong' %></div>
    <div class="error-msg"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred. Please try again.' %></div>
    <div>
      <a href="/" class="btn">← Home</a>
      <a href="/admin/login" class="btn btn-outline">Admin</a>
    </div>
  </div>
</body>
</html>
